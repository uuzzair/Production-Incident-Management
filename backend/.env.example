ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./data/incidents.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
API_KEYS=local-dev-token:admin
MAX_PAGE_LIMIT=100
LOG_LEVEL=INFO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
SESSION_COOKIE_NAME=incident_session
SESSION_COOKIE_SECRET=local-session-secret-change-me
SESSION_EXPIRY_HOURS=12
CSRF_COOKIE_NAME=incident_csrf
SECURE_COOKIES=false
