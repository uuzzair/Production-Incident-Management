ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./data/incidents.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=true
API_KEYS=local-dev-token:admin
MAX_PAGE_LIMIT=100
LOG_LEVEL=INFO
OIDC_ISSUER_URL=http://localhost:8082/realms/incidents-local
OIDC_BACKCHANNEL_ISSUER_URL=
OIDC_CLIENT_ID=fastapi-incidents
OIDC_CLIENT_SECRET=local-keycloak-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8001/api/v1/auth/callback
OIDC_AUTHORIZATION_URL=http://127.0.0.1:8082/realms/incidents-local/protocol/openid-connect/auth
SESSION_COOKIE_NAME=incident_session
SESSION_SECRET_KEY=local-session-secret-change-me-32
# Backward-compatible alias, prefer SESSION_SECRET_KEY:
# SESSION_COOKIE_SECRET=local-session-secret-change-me-32
SESSION_EXPIRY_HOURS=12
CSRF_COOKIE_NAME=incident_csrf
SECURE_COOKIES=false
OIDC_STATE_COOKIE_NAME=incident_oidc_state
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173
